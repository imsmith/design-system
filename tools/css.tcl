#!/usr/bin/env tclsh
# css.tcl — serialize tokens/**/*.edn to tokens/{colors,typography,spacing,effects}.css
# Run from the repo root: tclsh tools/css.tcl [outdir]   (default: tokens)
#
# The custom-property names are the public API consumed by components/ and
# ui_kits/; change them only with the consumers. fonts.css and base.css are
# hand-authored (font-face and element defaults), not tokens, and are not touched.

source [file join [file dirname [info script]] tcl edn.tcl]
set out [expr {$argc ? [lindex $argv 0] : "tokens"}]
foreach {var file} {themes color/themes spectrum color/spectrum status color/status
                    opinion color/opinion tlp color/markings type typography
                    space space motion motion material material} {
    set $var [edn::read tokens/$file.edn]
}
proc kw {k} { string range $k 1 end }
proc css_list {l} { join [lmap x $l {expr {[string match "* *" $x] ? "\"$x\"" : $x}}] ", " }
proc rem {v} { regsub {\.0$} $v "" v; return "${v}rem" }
proc rgba {hex a} { scan $hex "#%2x%2x%2x" r g b; return "rgba($r, $g, $b, $a)" }
proc emit {name body} {
    global out
    set f [open [file join $out $name] w]; fconfigure $f -encoding utf-8
    puts $f "/* $name — GENERATED by tools/css.tcl from the edn token files. Do not edit; run make css. */\n"
    puts -nonewline $f $body; close $f
    puts "wrote $out/$name"
}
proc prop {name value {comment ""}} {
    set line [format "  %-28s %s;" "$name:" $value]
    if {$comment ne ""} { append line "  /* $comment */" }
    return "$line\n"
}

# ---------- colors.css ----------
set c "/* CHROME — per-theme skin. Default skin is Tron dark on :root. Values from\n * tokens/color/themes.edn (APCA-verified). Pick ONE theme; never mix. */\n\n"
foreach {name t} [dict get $themes :themes] {
    foreach mode {:dark :light} {
        set sel [expr {$mode eq ":dark" ? "\[data-theme=\"[kw $name]\"\]" : "\[data-theme=\"[kw $name]\"\]\[data-mode=\"light\"\]"}]
        if {$name eq ":tron" && $mode eq ":dark"} { set sel ":root,\n$sel" }
        append c "$sel \{\n"
        set v [dict get $t $mode]
        foreach {role val} $v {
            if {$role eq ":accent-tint"} { append c [prop --accent-tint [rgba [dict get $v :accent] $val] "accent @ $val"]
            } else { append c [prop --[kw $role] $val] }
        }
        append c "\}\n\n"
    }
}
append c "/* DATA COLOR — theme-invariant. Declared once; a theme must never touch these. */\n\n:root \{\n"
append c "  /* Diverging spectrum (tokens/color/spectrum.edn). Green is the center; never categorical. */\n"
foreach s [dict get $spectrum :stops] { append c [prop --spectrum-[kw [dict get $s :name]] [dict get $s :hex24] [format %+d [dict get $s :index]]] }
append c "\n  /* Status alert ramp (tokens/color/status.edn). OASIS CAP severity. Never color alone. */\n"
foreach s [dict get $status :ramp] { append c [prop --status-[kw [dict get $s :step]] [dict get $s :hex24]] }
append c "  /* Label color on a status FILL (large/heavy text only). Fill is legal everywhere;\n   * outline (step as text/border) is dark-surface only; critical is always fill. */\n"
foreach s [dict get $status :ramp] { append c [prop --on-status-[kw [dict get $s :step]] [dict get $s :on-status]] }
append c "\n  /* STIX opinion (tokens/color/opinion.edn) on the muted spectrum. disagree = warm. */\n"
foreach o [dict get $opinion :map] { append c [prop --opinion-[dict get $o :value] [dict get $o :hex24] "spectrum [kw [dict get $o :stop]]"] }
append c "\n  /* TLP markings (tokens/color/markings.edn). Prescribed by the standard; shown on black. */\n"
foreach s [dict get $tlp :markings] {
    set n [dict get $s :name]
    if {[string match *STRICT* $n]} continue
    append c [prop --tlp-[string tolower [string range $n 4 end]] [dict get $s :hex24]]
}
append c [prop --tlp-bg [dict get $tlp :meta :background]]
append c "\}\n"
emit colors.css $c

# ---------- typography.css ----------
set c "/* The type duo (tokens/typography.edn). Mono is the voice; prose is long-form only. */\n\n:root \{\n"
append c [prop --font-mono [css_list [dict get $type :families :mono :stack]]]
append c [prop --font-prose [css_list [dict get $type :families :prose :stack]]]
append c "\n"
foreach s [dict get $type :scale] { append c [prop --text-[kw [dict get $s :token]] [rem [dict get $s :rem]] "[dict get $s :px] — [dict get $s :role]"] }
append c "\n"
foreach {k v} [dict get $type :weights] { append c [prop --weight-[kw $k] $v] }
append c "\n"
foreach {k v} [dict get $type :line-height] { append c [prop --leading-[kw $k] $v] }
append c "\n"
foreach {k v} [dict get $type :tracking] { append c [prop --tracking-[kw $k] $v] }
append c "\n"
append c [prop --measure-prose [dict get $space :measure :prose] "[dict get $space :measure :range]"]
append c "\}\n"
emit typography.css $c

# ---------- spacing.css ----------
set c "/* Spacing scale, density, grid, edges (tokens/space.edn). 8px base. Terminal\n * layouts do not use this scale — they count mono cells. */\n\n:root \{\n"
foreach s [dict get $space :scale] { append c [prop --[kw [dict get $s :token]] [rem [dict get $s :rem]] "[dict get $s :px]px[expr {[dict exists $s :role] ? " — [dict get $s :role]" : ""}]"] }
append c "\n"
foreach {k v} [dict get $space :density] { append c [prop --density-[kw $k] "var(--[kw [dict get $v :token]])" "[dict get $v :px] — [dict get $v :role]"] }
append c "\n"
append c [prop --grid-columns [dict get $space :grid :columns]]
append c [prop --grid-gutter "var(--[kw [dict get $space :grid :gutter :token]])" "[dict get $space :grid :gutter :px]"]
append c [prop --grid-margin "var(--[kw [dict get $space :grid :margin :token]])" "[dict get $space :grid :margin :px]"]
append c "\n"
append c [prop --border-width [dict get $space :border :width]]
foreach r [dict get $space :radius] { append c [prop --[kw [dict get $r :token]] "[dict get $r :px][expr {[dict get $r :px] ? "px" : ""}]" [dict get $r :role]] }
append c "\}\n\n/* Breakpoints (tokens/space.edn :grid :breakpoints):"
foreach b [dict get $space :grid :breakpoints] { if {[dict get $b :min]} { append c " [kw [dict get $b :name]] [dict get $b :min] ·" } }
set c "[string trimright $c " ·"] */\n"
emit spacing.css $c

# ---------- effects.css ----------
proc shadow {entries} {
    join [lmap e $entries {
        set a [dict get $e :alpha]
        set col [expr {$a >= 1.0 ? "var(--glow)" : "color-mix(in srgb, var(--glow) [expr {int($a*100)}]%, transparent)"}]
        format "%s %s %spx %s" [dict get $e :x] [dict get $e :y] [dict get $e :blur] $col
    }] ", "
}
set c "/* Glow (tokens/material.edn) — the only material effect, dark surfaces only. Motion\n * (tokens/motion.edn) — minimal/functional. */\n\n:root \{\n"
set glowNames {}
foreach kind {:text :box} { foreach {lvl kinds} [dict get $material :glow] {
    set n --glow-[kw $kind]-[kw $lvl]; lappend glowNames $n
    append c [prop $n [shadow [dict get $kinds $kind]]]
}}
append c "\n"
foreach d [dict get $motion :duration] { append c [prop --dur-[kw [dict get $d :token]] [dict get $d :ms]ms [dict get $d :role]] }
append c "\n"
foreach {k v} [dict get $motion :easing] { append c [prop --ease-[kw $k] $v] }
append c "\n"
append c [prop --pulse-period [dict get $motion :pulse :period-ms]ms [dict get $motion :pulse :use]]
append c "\}\n\n/* Glow is suppressed on light surfaces (tokens/material.edn :meta :surfaces). */\n\[data-mode=\"light\"\] \{\n"
foreach n $glowNames { append c [prop $n none] }
append c "\}\n\n/* The single status motion: the critical pulse. Reinforcement only. */\n"
append c "@keyframes ds-pulse \{\n  0%, 100% \{ opacity: 1; \}\n  50%      \{ opacity: 0.45; \}\n\}\n"
append c ".ds-pulse \{\n  animation: ds-pulse var(--pulse-period) var(--ease-standard) infinite;\n\}\n\n"
append c "@media (prefers-reduced-motion: reduce) \{\n  .ds-pulse \{ animation: none; \}\n\}\n"
emit effects.css $c
