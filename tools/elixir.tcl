#!/usr/bin/env tclsh
# elixir.tcl — serialize tokens/**/*.edn to tokens/design_system_tokens.ex
# Run from the repo root: tclsh tools/elixir.tcl [outdir]   (default: tokens)
#
# One Elixir module of plain data for BEAM consumers (Phoenix/LiveView
# components, Livebook charts). Keywords become atoms, strings stay strings,
# vectors become lists, maps become maps. No logic lives here.

source [file join [file dirname [info script]] tcl edn.tcl]
set out [expr {$argc ? [lindex $argv 0] : "tokens"}]
proc kw {k} { string range $k 1 end }
set S "\x01"   ;# string marker from edn::read -mark
set V "\x02"   ;# vector marker from edn::read -mark
proc str {v} { return "\"[string map {\\ \\\\ \" \\\"} [string range $v 1 end]]\"" }
proc iskw {v} { regexp {^:[A-Za-z0-9_+/-]+$} $v }
proc isstr {v} { global S; string equal [string index $v 0] $S }
proc atom {v} {
    set a [string map {- _} [string range $v 1 end]]
    expr {[regexp {^[a-zA-Z_][a-zA-Z0-9_]*[?!]?$} $a] ? ":$a" : ":\"$a\""}
}
# Exact dispatch: scalars by shape, vectors by the \x02 marker, maps otherwise.
proc ex {v {ind 2}} {
    global V
    if {$v eq "nil"} { return "nil" }
    if {$v eq "true" || $v eq "false"} { return $v }
    if {[string is double -strict $v]} { return $v }
    if {[iskw $v]} { return [atom $v] }
    if {[isstr $v]} { return [str $v] }
    set pad [string repeat " " $ind]
    if {[lindex $v 0] eq $V} {
        return "\[[join [lmap x [lrange $v 1 end] {ex $x [expr {$ind+2}]}] ", "]\]"
    }
    if {[llength $v] % 2} { error "odd map: $v" }
    if {[llength $v] == 0} { return "%\{\}" }
    set parts {}
    foreach {k val} $v {
        set key [expr {[iskw $k] ? "[string map {- _} [string range $k 1 end]]:" : "[str $k] =>"}]
        lappend parts "$pad  $key [ex $val [expr {$ind+2}]]"
    }
    return "%\{\n[join $parts ",\n"]\n$pad\}"
}
proc atomkey {k} { return [string map {- _} [kw $k]] }

set body ""
foreach {fn file} {themes color/themes spectrum color/spectrum status color/status
                   opinion color/opinion markings color/markings typography typography
                   space space motion motion material material marks marks
                   voice voice components components} {
    set d [edn::read tokens/$file.edn -mark]
    set entries {}
    foreach {k v} $d { if {$k ne ":meta"} { lappend entries "    [atomkey $k]: [ex $v 4]" } }
    append body "  @doc \"From `tokens/$file.edn`.\"\n  def $fn do\n    %\{\n[join $entries ",\n"]\n    \}\n  end\n\n"
}
set f [open [file join $out design_system_tokens.ex] w]; fconfigure $f -encoding utf-8
puts $f "# GENERATED by tools/elixir.tcl from the edn token files. Do not edit; run make elixir.
defmodule DesignSystem.Tokens do
  @moduledoc \"\"\"
  The design-system token backbone as plain Elixir data.

  Generated from `tokens/**/*.edn`, which is the authority for values; the
  manual is the authority for meaning. One function per token file.
  \"\"\"

[string trimright $body]
end"
close $f
puts "wrote $out/design_system_tokens.ex"
