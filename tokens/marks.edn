;; marks.edn — the mark / icon registry
;;
;; Canonical list of every mark in assets/marks/sprite.svg: its id, category,
;; meaning, and the terminal fallbacks (Unicode primary, ASCII last-resort) that
;; let it survive where SVG cannot render. Status and diverging marks MUST carry
;; both fallbacks (accessibility-critical, per manual/10-accessibility.md). UI
;; marks fall back to a Unicode glyph where a clean one exists, else to a text
;; label in terminal contexts.
;;
;; Style is fixed for all marks: 24x24 grid, 2px stroke, round caps/joins,
;; monoline outline, color via currentColor. See manual/04-marks-iconography.md.
;;
;; Authoritative for the REGISTRY. Geometry lives in assets/marks/sprite.svg;
;; meaning lives in the chapter. The three must agree.

{:meta {:name   "marks"
        :sprite "assets/marks/sprite.svg"
        :grid   24
        :stroke 2
        :style  :monoline-outline
        :color  "currentColor"
        :reserved "the 5 status shapes are reserved; UI marks must not reuse them"
        ;; Fallback order, richest to poorest. :nerd is a PUA codepoint (hex) in
        ;; MartianMono Nerd Font (see typography.edn); :nerd-name is its Nerd Fonts
        ;; glyph id. The terminal glyphs use the closest stable Font Awesome 4
        ;; equivalents — exact sign-shape silhouettes are an SVG-tier feature.
        :fallback-order [:svg :nerd :unicode :ascii]
        :nerd-font "MartianMono Nerd Font Mono"}

 ;; Sign-shape semantics. step = the alert-ramp step (see status.edn).
 :status
 [{:id "m-critical" :step :critical :shape :octagon  :symbol :x     :unicode "✖" :ascii "[X]" :nerd "f05c" :nerd-name "nf-fa-times_circle"}
  {:id "m-high"     :step :high     :shape :triangle :symbol :bang  :unicode "▲" :ascii "[!]" :nerd "f071" :nerd-name "nf-fa-warning"}
  {:id "m-medium"   :step :medium   :shape :diamond  :symbol :bang  :unicode "◆" :ascii "[*]" :nerd "f06a" :nerd-name "nf-fa-exclamation_circle"}
  {:id "m-low"      :step :low      :shape :circle   :symbol :check :unicode "●" :ascii "[+]" :nerd "f058" :nerd-name "nf-fa-check_circle"}
  {:id "m-unknown"  :step :unknown  :shape :square   :symbol :query :unicode "□" :ascii "[?]" :nerd "f059" :nerd-name "nf-fa-question_circle"}]

 ;; Temperature direction for the diverging spectrum (see spectrum.edn).
 ;; The mark carries the SIGN; magnitude stays in the value/position.
 :diverging
 [{:id "m-warm"    :sign :positive :pole :warm   :unicode "⌃" :ascii "^" :nerd "f106" :nerd-name "nf-fa-angle_up"}
  {:id "m-neutral" :sign :zero     :pole :center :unicode "–" :ascii "-" :nerd "f068" :nerd-name "nf-fa-minus"}
  {:id "m-cool"    :sign :negative :pole :cool   :unicode "⌄" :ascii "v" :nerd "f107" :nerd-name "nf-fa-angle_down"}]

 ;; Functional starter set. chevron rotates for the four directions.
 :ui
 [{:id "m-close"    :group :nav     :unicode "✕" :ascii "x"   :nerd "f00d" :nerd-name "nf-fa-times"}
  {:id "m-menu"     :group :nav     :unicode "≡" :ascii "="   :nerd "f0c9" :nerd-name "nf-fa-bars"}
  {:id "m-chevron"  :group :nav     :unicode "›" :ascii ">"   :nerd "f054" :nerd-name "nf-fa-chevron_right" :note "rotate 90/180/270 for up/left/down"}
  {:id "m-more"     :group :nav     :unicode "⋯" :ascii "..." :nerd "f141" :nerd-name "nf-fa-ellipsis_h"}
  {:id "m-search"   :group :action  :unicode "⌕" :ascii nil   :nerd "f002" :nerd-name "nf-fa-search"}
  {:id "m-add"      :group :action  :unicode "+"      :ascii "+"   :nerd "f067" :nerd-name "nf-fa-plus"}
  {:id "m-remove"   :group :action  :unicode "−" :ascii "-"   :nerd "f068" :nerd-name "nf-fa-minus"}
  {:id "m-edit"     :group :action  :unicode "✎" :ascii nil   :nerd "f040" :nerd-name "nf-fa-pencil"}
  {:id "m-delete"   :group :action  :unicode nil       :ascii "del" :nerd "f1f8" :nerd-name "nf-fa-trash"}
  {:id "m-refresh"  :group :action  :unicode "↻" :ascii nil   :nerd "f021" :nerd-name "nf-fa-refresh"}
  {:id "m-filter"   :group :action  :unicode "▽" :ascii nil   :nerd "f0b0" :nerd-name "nf-fa-filter"}
  {:id "m-download" :group :action  :unicode "↓" :ascii "v"   :nerd "f019" :nerd-name "nf-fa-download"}
  {:id "m-upload"   :group :action  :unicode "↑" :ascii "^"   :nerd "f093" :nerd-name "nf-fa-upload"}
  {:id "m-settings" :group :object  :unicode "⚙" :ascii nil   :nerd "f013" :nerd-name "nf-fa-cog"}
  {:id "m-info"     :group :object  :unicode "ⓘ" :ascii "i"   :nerd "f05a" :nerd-name "nf-fa-info_circle"}
  {:id "m-help"     :group :object  :unicode "?"      :ascii "?"   :nerd "f128" :nerd-name "nf-fa-question"}
  {:id "m-user"     :group :object  :unicode nil       :ascii nil   :nerd "f007" :nerd-name "nf-fa-user"}
  {:id "m-lock"     :group :object  :unicode nil       :ascii nil   :nerd "f023" :nerd-name "nf-fa-lock"}
  {:id "m-bell"     :group :object  :unicode nil       :ascii nil   :nerd "f0f3" :nerd-name "nf-fa-bell"}
  {:id "m-chat"     :group :nav     :unicode nil       :ascii "chat" :nerd "f086" :nerd-name "nf-fa-comments"}
  {:id "m-event"    :group :nav     :unicode nil       :ascii "ev"   :nerd "f0e7" :nerd-name "nf-fa-bolt"}
  {:id "m-system"   :group :nav     :unicode nil       :ascii "sys"  :nerd "f233" :nerd-name "nf-fa-server"}
  {:id "m-tool"     :group :object  :unicode nil       :ascii "tool" :nerd "f0ad" :nerd-name "nf-fa-wrench"}
  {:id "m-hub"      :group :nav     :unicode "⇄" :ascii "<->"  :nerd "f0ec" :nerd-name "nf-fa-exchange"}
  {:id "m-agent"    :group :object  :unicode nil       :ascii "agt"  :nerd "f2db" :nerd-name "nf-fa-microchip"}
  {:id "m-run"      :group :action  :unicode "▶" :ascii ">"    :nerd "f04b" :nerd-name "nf-fa-play"}
  {:id "m-send"     :group :action  :unicode "➤" :ascii "->"   :nerd "f1d8" :nerd-name "nf-fa-paper_plane"}
  {:id "m-external" :group :action  :unicode "↗" :ascii "^"    :nerd "f08e" :nerd-name "nf-fa-external_link"}
  ;; appearance pickers: mode (sun/moon/screen) — screen = follow the OS
  {:id "m-sun"      :group :object  :unicode "☀" :ascii "lt"   :nerd "f185" :nerd-name "nf-fa-sun_o"}
  {:id "m-moon"     :group :object  :unicode "☾" :ascii "dk"   :nerd "f186" :nerd-name "nf-fa-moon_o"}
  {:id "m-screen"   :group :object  :unicode nil       :ascii "sys"  :nerd "f108" :nerd-name "nf-fa-desktop"}
  ;; social / collection
  {:id "m-star"     :group :action  :unicode "★" :ascii "*"    :nerd "f005" :nerd-name "nf-fa-star" :note "outline at rest; fill = selected"}
  {:id "m-bookmark" :group :action  :unicode nil       :ascii "bk"   :nerd "f02e" :nerd-name "nf-fa-bookmark" :note "outline at rest; fill = saved"}
  {:id "m-share"    :group :action  :unicode nil       :ascii "shr"  :nerd "f1e0" :nerd-name "nf-fa-share_alt"}
  ;; theme emblems: one per anchor theme, drawn in the theme's accent. No terminal tier — a theme is named in text there.
  {:id "m-tron"     :group :theme   :unicode nil       :ascii "tron"   :nerd nil :nerd-name nil :note "the program, identity disc held overhead"}
  {:id "m-matrix"   :group :theme   :unicode nil       :ascii "matrix" :nerd nil :nerd-name nil :note "digital rain"}
  {:id "m-compaq"   :group :theme   :unicode nil       :ascii "compaq" :nerd nil :nerd-name nil :note "the amber CRT, prompt lit"}]}
