           :on-accent "#000000" :glow "#FF8A00"}
   :light {:bg "#fbf4ea" :surface "#ffffff" :text "#2a1a06"
           :muted "#837a6f" :border "#bbb6af" :accent "#c96a00"
           :on-accent "#ffffff" :glow "#FF8A00"}}}}
