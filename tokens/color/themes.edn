;; themes.edn — the three anchor themes (chrome only)
;;
;; A theme is a SKIN. It owns exactly the chrome roles below and nothing else.
;; It may NOT touch the spectrum, the status ramp, or the markings — those are
;; data color and are theme-invariant. Each anchor has a :dark and :light variant.
;;
;; Roles: :bg :surface :text :muted :border :accent :on-accent :glow
;; light :accent is darkened from the raw anchor where contrast on a light
;; surface demands it; :glow keeps the raw anchor (glow sits on dark material).
;; :on-accent is the black/white foreground placed atop the accent fill; per the
;; accessibility verification it is rated for LARGE/heavy text only (see
;; manual/10-accessibility.md). All muted/border/text/on-accent pairs are
;; APCA-verified against the adopted thresholds.
;;
;; Authoritative for VALUES. See manual/01-color.md section 6 for MEANING.

{:meta {:name  "anchor-themes"
        :roles [:bg :surface :text :muted :border :accent :on-accent :glow]
        :rule  "chrome only; data color is invariant"
        :contrast {:model "APCA (apca-w3 reference)"
                   :thresholds {:text 75 :muted 60 :border 30 :on-accent 45}}}

 :themes
 {:tron
  {:lineage "Tron — cyan vector grid"
   :anchor  "#00E5FF"
   :dark  {:bg "#05080a" :surface "#0a141a" :text "#cfeff5"
           :muted "#a2bdc3" :border "#6d8288" :accent "#00E5FF"
           :on-accent "#000000" :glow "#00E5FF"}
   :light {:bg "#eef7f9" :surface "#ffffff" :text "#07232a"
           :muted "#6d7d81" :border "#adb6b9" :accent "#008c9e"
           :on-accent "#ffffff" :glow "#00E5FF"}}

  :matrix
