;; components.edn — the state matrix
;;
;; Components compose existing tokens (color, type, space, marks, material); they
;; introduce no new primitive values, so this file holds only the one reusable,
;; serializable artifact: the STATE MATRIX — how each interactive state maps to
;; token roles. Component anatomy and per-component specs live in the chapter.
;;
;; Keyword values reference roles/tokens in the other edn files; string values are
;; prose treatment notes. Authoritative for the matrix; see
;; manual/06-components-states.md for MEANING and per-component specs.

{:meta {:name "component-state-matrix"
        :states [:default :hover :focus :active :disabled :loading :error :selected :read-only]
        :composes ["color/themes" "color/status" "typography" "space" "marks" "material"]}

 :state-matrix
 {:default   {:bg :surface :text :text :border :border :glow nil}
  :hover     {:emphasis "outlined: border→accent; filled: brighten accent" :glow :ambient}
  :focus     {:outline :text :outline-offset "space-half (4px)" :glow :active
              :note "outline is the signal; glow is reinforcement (Accessibility §5)"}
  :active    {:fill :accent :on-fill :on-accent :shift "pressed/inset"}
  :disabled  {:text :muted :opacity 0.5 :glow nil :interactive false}
  :loading   {:indicator "m-refresh (animated)" :aria-busy true :content :hidden}
  :error     {:border :status/critical :text :status/critical
              :message true :glyph "m-critical" :note "color + glyph + text, never color alone"}
  :selected  {:tint "accent @ low alpha" :rule "accent left/underline" :glow nil}
  :read-only {:border :none :bg :surface :editable false :selectable true}}

 ;; Gauge / meter — two semantic types that are never interchanged.
 :gauge
 {:diverging  {:color    :color/spectrum        ; spectrum stop at signed magnitude
               :center   :green
               :mark     [:m-warm :m-neutral :m-cool]
               :label    "signed value, always shown"
               :use      "temperature, error-vs-baseline, STIX opinion"}
  :sequential {:fill      :accent
               :threshold "alert ramp: warn→medium, crit→critical"
               :thresholds "per-instance config (e.g. warn 70%, crit 90%), not a token"
               :label     "value + threshold word (Voice display synonym)"
               :use       "CPU, disk, memory, throughput, quota"}
  :forms      [:linear :radial]
  :no-data    {:color :muted :glyph "m-unknown" :word "UNK"}}

 ;; Chart / sparkline — the gauge extended to series/time. Tufte by default.
 :chart
 {:forms      [:sparkline :line-area :bar]
  :diverging  {:color :color/spectrum :baseline "dashed nominal (green/0)"}
  :threshold  {:line :accent :crossing "alert ramp color + word"}
  :plain      {:line :text}
  :many       {:strategy :small-multiples
               :overlay  "≤2-3 series: mono-ramp (accent solid, muted dashed) + direct end-labels"
               :never    "categorical color palette — spectrum is diverging, not categorical"}
  :no-data    {:color :muted :glyph "m-unknown" :word "UNK"}
  :terminal   "block/braille sparkline + value + status word"}

 ;; Overlay behavior shared by modal / toast / tooltip / menu.
 :overlay
 {:modal   {:focus-trap true :return-focus true :dismiss [:esc :scrim]
            :aria "aria-modal, labelled by title" :motion [:deliberate :enter :exit]}
  :toast   {:auto-dismiss "timer by severity; critical persists"
            :aria-live "polite; assertive for critical" :affordance "m-bell"}
  :tooltip {:trigger [:hover :focus] :dismiss [:blur :esc]
            :rule "never the sole carrier of essential info"}
  :menu    {:keyboard true :selected "accent tint + rule" :dismiss [:select :blur :esc]}}

 ;; Destructive primary actions break the accent norm — the only place they do.
 :destructive {:color :status/critical
               :label "verb naming the act (e.g. DELETE)"
               :copy "name the target; state irreversibility (Voice §3)"
               :cancel :ghost}}
